    "pages:stage": "npm run build && node scripts/stage-pages.mjs"
  },
  "devDependencies": {
    "@mirohq/websdk-types": "latest",
    "gh-pages": "^6.1.1",
    "typescript": "^5.4.5",
    "vite": "^5.2.0"
  }
}
